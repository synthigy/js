    {
      "description": "Dashboard headline numbers — totals for movies, ratings and actors, plus the average rating.",
      "name": "stats",
      "params": [],
      "op": "sql-template",
      "source": "-- One CTE per entity, not scalar subqueries: RLS guards are injected per\n-- CTE scope, so each aggregate is scoped to what the caller may read.\nWITH m  AS (SELECT count(*) AS n FROM {movie}),\n     r  AS (SELECT count(*) AS n, avg({user_rating.value}) AS avg_value FROM {user_rating}),\n     ma AS (SELECT count(*) AS n FROM {movie_actor})\nSELECT m.n          AS total_movies,\n       r.n          AS total_ratings,\n       r.avg_value  AS avg_rating,\n       ma.n         AS total_actors\nFROM m, r, ma",
      "result": {
        "kind": "object",
        "fields": [
          {
            "key": "total_movies",
            "type": "int",
            "nullable": false
          },
          {
            "key": "total_ratings",
            "type": "int",
            "nullable": false
          },
          {
            "key": "avg_rating",
            "type": "float"
          },
          {
            "key": "total_actors",
            "type": "int",
            "nullable": false
          }
        ]
      },
      "watch": [
        "movie",
        "user_rating",
        "movie_actor"
      ],
      "entity": null,
      "namespace": "dashboard"
    }
